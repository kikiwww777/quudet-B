# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL is the only supported backend.
#   Local dev without Docker: postgresql+psycopg2://quudet:quudet@localhost:5432/quudet
#   Docker:                  postgresql+psycopg2://quudet:quudet@db:5432/quudet
DATABASE_URL=postgresql+psycopg2://quudet:quudet@localhost:5432/quudet

# ── Redis (Celery broker) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Execution backend ─────────────────────────────────────────────────
#   celery        — jobs dispatched via Celery worker (production / Docker)
#   remote-agent  — jobs claimed by remote agents (legacy cluster mode)
EXECUTION_BACKEND=celery

# ── Security ──────────────────────────────────────────────────────────
SECRET_KEY=replace-with-long-random-string
FIRST_SUPERUSER_EMAIL=admin@quudet.local
FIRST_SUPERUSER_PASSWORD=admin123

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080,http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────────
# No JWT: open API for local/LAN use. Set false + strong SECRET_KEY for public internet.
DISABLE_AUTH=true

# ── Paths ─────────────────────────────────────────────────────────────
# Repo root containing ultralytics-main/ (Windows example: D:/yolo26)
# YOLO_WORK_DIR=D:/yolo26

# ── Cluster (legacy, only used when EXECUTION_BACKEND=remote-agent) ──
CLUSTER_ENABLED=false
NODE_SHARED_TOKEN=replace-with-shared-node-token
NODE_HEARTBEAT_TIMEOUT_SECONDS=20
