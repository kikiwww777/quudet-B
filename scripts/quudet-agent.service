[Unit]
Description=QuuDet Linux node agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/quudet-B/quudet-yolo-lab-backend
EnvironmentFile=/home/%i/.config/quudet-agent.env
ExecStart=/home/%i/quudet-B/scripts/run-linux-agent.sh
Restart=always
RestartSec=5
KillMode=control-group

[Install]
WantedBy=multi-user.target
