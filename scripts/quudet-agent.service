[Unit]
Description=QuuDet Linux node agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/quudet-B/quudet-yolo-lab-backend
EnvironmentFile=/etc/quudet-agent/%i.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/%i/quudet-B/quudet-yolo-lab-backend/.venv/bin/python -m app.agent.runner
Restart=always
RestartSec=5
KillMode=control-group

[Install]
WantedBy=multi-user.target
